# Required — get from https://openrouter.ai/
OPENAI_API_KEY=sk-or-v1-...

# Required — min 32 characters. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789

# Optional — cookie settings (defaults: secure=false, domain=)
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Required — PostgreSQL connection string
# For Docker Compose: use 'db' as hostname (service name)
# For local dev: use 'localhost'
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/poster

# Optional — LangSmith tracing (can be empty string)
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
